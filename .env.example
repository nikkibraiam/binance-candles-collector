# Binance USD-M futures REST base URL
BINANCE_URL=https://fapi.binance.com

# PostgreSQL (or PgBouncer) connection
HOST_DATABASE=localhost
PORT_DATABASE=5432
USER_DATABASE=postgres
PASS_DATABASE=
NAME_DATABASE=bot-trading

# Optional: comma-separated lists; defaults to all intervals and the built-in symbols
INTERVALS=
SYMBOLS=
SYMBOL_PAUSE_SECONDS=60
